# An OpenShift project. Copy to openshift.tfvars (ignored by git), fill in, then:
# terraform apply -var-file=openshift.tfvars
kube_context      = "<project>/api-<cluster>:6443/<user>" # after oc login
overlay           = "openshift"
namespace         = "<project>"
create_namespace  = false
image_registry    = "image-registry.openshift-image-registry.svc:5000/<project>"
image_tag         = "<commit sha>"
route_host        = "callslip.apps.<cluster domain>"
anthropic_api_key = "sk-ant-..."
