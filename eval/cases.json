    {
      "id": "9-supersession",
      "category": "Conflicting sources (resolved by supersession)",
      "question": "How long do CFO Act agencies have to publish an AI strategy under the OMB AI memos?",
      "expect": "conflict",
      "gold": [
        {
          "doc": "OMB M-24-10",
          "pages": [
            9
          ]
        },
        {
          "doc": "OMB M-25-21",
          "pages": [
            1,
            5
          ]
        }
      ],
      "min_documents": 2,
      "required": [
        "365",
        "180",
        "(rescind|replace|supersed)"
      ],
      "forbidden": [],
      "must_cite": [
        {
          "doc": "OMB M-25-21",
          "pages": [
            1
          ]
        }
      ],
      "note": "M-25-21 p. 1 says it rescinds and replaces M-24-10. Saying which deadline governs needs that page cited; a guess from the dates does not count."
    },
    {
