          ]
        }
      ],
      "required": [
        "(personal|PII)",
        "(memoriz|leak)"
      ],
      "forbidden": []
    },
    {
      "id": "8b-tool-keeps-failing",
      "category": "Tool failure or timeout (persistent)",
      "question": "How does the NIST Generative AI Profile describe data privacy risks?",
      "expect": "recover_or_incomplete",
      "faults": {
        "search_documents": "error"
      },
      "gold": [
        {
          "doc": "NIST AI 600-1",
