# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required: database password (any long random string for local use).
POSTGRES_PASSWORD=change-me

# Required for answering questions: an Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional
# POSTGRES_USER=rag
# POSTGRES_DB=rag
# WEB_PORT=8080
# LOG_LEVEL=INFO
# IMAGE_TAG=dev

# Any setting in backend/app/config.py can be set here in capitals, for example:
# ANSWER_MODEL=claude-sonnet-5-5
# ANSWER_EFFORT=medium
# MAX_TOOL_CALLS=9
# RUN_DEADLINE_S=90
